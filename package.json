{
  "name": "survey-studio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "tsx --test tests/engine.test.ts tests/branch-routing.test.ts tests/frontend-routing.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:seed:manual": "tsx tests/manual-seed.ts",
    "db:init": "node scripts/init-db.cjs",
    "seed": "tsx scripts/seed-manual.ts",
    "seed:manual": "tsx scripts/seed-manual.ts",
    "seed:system": "tsx scripts/seed.ts",
    "routing:preview": "tsx scripts/preview-routing.ts",
    "routing:migrate": "tsx scripts/migrate-system-routing.ts",
    "routing:migrate:apply": "tsx scripts/migrate-system-routing.ts --apply",
    "format": "prettier --write \"apps/**/*.{ts,vue,css,json,html}\" \"tests/*.ts\" \"scripts/*.{ts,cjs}\" \"docs/*.md\" README.md"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "concurrently": "^9.1.2",
    "node": "^22.23.4",
    "prettier": "^3.9.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
